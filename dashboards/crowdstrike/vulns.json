apiVersion: grafana.integreatly.org/v1beta1
kind: GrafanaDashboard
metadata:
  name: falcon-vulns
  namespace: y-tree-crowdstrike
spec:
  allowCrossNamespaceImport: true
  instanceSelector:
    matchLabels:
      dashboards: grafana
  resyncPeriod: 10m0s
  json: |
    {
      "annotations": {
        "list": [
          {
            "builtIn": 1,
            "datasource": {
              "type": "grafana",
              "uid": "-- Grafana --"
            },
            "enable": true,
            "hide": true,
            "name": "Annotations & Alerts",
            "type": "dashboard"
          }
        ]
      },
      "editable": true,
      "fiscalYearStartMonth": 0,
      "graphTooltip": 0,
      "links": [],
      "liveNow": false,
      "panels": [
        {
          "type": "stat",
          "title": "Open vulnerabilities",
          "datasource": {
            "type": "postgres",
            "uid": "falcon-postgres"
          },
          "gridPos": {
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 4
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "color": {
                "mode": "fixed"
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "value",
            "graphMode": "none",
            "textMode": "auto",
            "justifyMode": "auto"
          },
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "falcon-postgres"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT count(*) AS v FROM falcon.v_open_vulns WHERE severity IN (${severity:singlequote}) AND COALESCE(platform_name,'UNKNOWN') IN (${platform:singlequote}) AND ('${host}' = '' OR hostname ILIKE '%${host}%') AND ('${kev}' = 'all' OR is_cisa_kev = ${kev})",
              "refId": "A"
            }
          ]
        },
        {
          "type": "stat",
          "title": "Critical (open)",
          "datasource": {
            "type": "postgres",
            "uid": "falcon-postgres"
          },
          "gridPos": {
            "x": 6,
            "y": 0,
            "w": 6,
            "h": 4
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "color": {
                "mode": "fixed"
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "value",
            "graphMode": "none",
            "textMode": "auto",
            "justifyMode": "auto"
          },
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "falcon-postgres"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT count(*) FILTER (WHERE severity='CRITICAL') AS v FROM falcon.v_open_vulns WHERE severity IN (${severity:singlequote}) AND COALESCE(platform_name,'UNKNOWN') IN (${platform:singlequote}) AND ('${host}' = '' OR hostname ILIKE '%${host}%') AND ('${kev}' = 'all' OR is_cisa_kev = ${kev})",
              "refId": "A"
            }
          ]
        },
        {
          "type": "stat",
          "title": "CISA KEV (open)",
          "datasource": {
            "type": "postgres",
            "uid": "falcon-postgres"
          },
          "gridPos": {
            "x": 12,
            "y": 0,
            "w": 6,
            "h": 4
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "color": {
                "mode": "fixed"
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "value",
            "graphMode": "none",
            "textMode": "auto",
            "justifyMode": "auto"
          },
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "falcon-postgres"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT count(*) FILTER (WHERE is_cisa_kev) AS v FROM falcon.v_open_vulns WHERE severity IN (${severity:singlequote}) AND COALESCE(platform_name,'UNKNOWN') IN (${platform:singlequote}) AND ('${host}' = '' OR hostname ILIKE '%${host}%') AND ('${kev}' = 'all' OR is_cisa_kev = ${kev})",
              "refId": "A"
            }
          ]
        },
        {
          "type": "stat",
          "title": "Affected hosts",
          "datasource": {
            "type": "postgres",
            "uid": "falcon-postgres"
          },
          "gridPos": {
            "x": 18,
            "y": 0,
            "w": 6,
            "h": 4
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "color": {
                "mode": "fixed"
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "value",
            "graphMode": "none",
            "textMode": "auto",
            "justifyMode": "auto"
          },
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "falcon-postgres"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT count(DISTINCT aid) AS v FROM falcon.v_open_vulns WHERE severity IN (${severity:singlequote}) AND COALESCE(platform_name,'UNKNOWN') IN (${platform:singlequote}) AND ('${host}' = '' OR hostname ILIKE '%${host}%') AND ('${kev}' = 'all' OR is_cisa_kev = ${kev})",
              "refId": "A"
            }
          ]
        },
        {
          "type": "piechart",
          "title": "Open by severity",
          "datasource": {
            "type": "postgres",
            "uid": "falcon-postgres"
          },
          "gridPos": {
            "x": 0,
            "y": 4,
            "w": 8,
            "h": 9
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "hideFrom": {}
              },
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "CRITICAL": {
                      "color": "#7A1516",
                      "index": 0
                    },
                    "HIGH": {
                      "color": "#C4162A",
                      "index": 1
                    },
                    "MEDIUM": {
                      "color": "#E0902E",
                      "index": 2
                    },
                    "LOW": {
                      "color": "#3274D9",
                      "index": 3
                    },
                    "NONE": {
                      "color": "#5B6370",
                      "index": 4
                    },
                    "UNKNOWN": {
                      "color": "#5B6370",
                      "index": 5
                    }
                  }
                }
              ],
              "color": {
                "mode": "fixed"
              }
            },
            "overrides": []
          },
          "options": {
            "pieType": "donut",
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "values": [
                "value"
              ]
            },
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "values": true
            },
            "tooltip": {
              "mode": "single"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "falcon-postgres"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT severity AS metric, count(*) AS value FROM falcon.v_open_vulns WHERE severity IN (${severity:singlequote}) AND COALESCE(platform_name,'UNKNOWN') IN (${platform:singlequote}) AND ('${host}' = '' OR hostname ILIKE '%${host}%') AND ('${kev}' = 'all' OR is_cisa_kev = ${kev}) GROUP BY severity ORDER BY 2 DESC",
              "refId": "A"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Open vulnerabilities trend (by severity)",
          "datasource": {
            "type": "postgres",
            "uid": "falcon-postgres"
          },
          "gridPos": {
            "x": 8,
            "y": 4,
            "w": 16,
            "h": 9
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "fillOpacity": 15,
                "stacking": {
                  "mode": "normal"
                },
                "lineWidth": 1,
                "showPoints": "auto"
              },
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "CRITICAL": {
                      "color": "#7A1516",
                      "index": 0
                    },
                    "HIGH": {
                      "color": "#C4162A",
                      "index": 1
                    },
                    "MEDIUM": {
                      "color": "#E0902E",
                      "index": 2
                    },
                    "LOW": {
                      "color": "#3274D9",
                      "index": 3
                    },
                    "NONE": {
                      "color": "#5B6370",
                      "index": 4
                    },
                    "UNKNOWN": {
                      "color": "#5B6370",
                      "index": 5
                    }
                  }
                }
              ],
              "color": {
                "mode": "fixed"
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "last"
              ]
            },
            "tooltip": {
              "mode": "multi"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "falcon-postgres"
              },
              "format": "time_series",
              "rawQuery": true,
              "rawSql": "SELECT snapshot_date AS time, severity AS metric, sum(open_count)::float AS value FROM falcon.v_vuln_trend WHERE severity IN (${severity:singlequote}) AND platform IN (${platform:singlequote}) GROUP BY snapshot_date, severity ORDER BY snapshot_date",
              "refId": "A"
            }
          ]
        },
        {
          "type": "table",
          "title": "Open vulnerabilities",
          "datasource": {
            "type": "postgres",
            "uid": "falcon-postgres"
          },
          "gridPos": {
            "x": 0,
            "y": 13,
            "w": 24,
            "h": 12
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "filterable": true,
                "align": "auto"
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "severity"
                },
                "properties": [
                  {
                    "id": "mappings",
                    "value": [
                      {
                        "type": "value",
                        "options": {
                          "CRITICAL": {
                            "color": "#7A1516",
                            "index": 0
                          },
                          "HIGH": {
                            "color": "#C4162A",
                            "index": 1
                          },
                          "MEDIUM": {
                            "color": "#E0902E",
                            "index": 2
                          },
                          "LOW": {
                            "color": "#3274D9",
                            "index": 3
                          },
                          "NONE": {
                            "color": "#5B6370",
                            "index": 4
                          },
                          "UNKNOWN": {
                            "color": "#5B6370",
                            "index": 5
                          }
                        }
                      }
                    ]
                  },
                  {
                    "id": "custom.cellOptions",
                    "value": {
                      "type": "color-background",
                      "mode": "gradient"
                    }
                  },
                  {
                    "id": "custom.width",
                    "value": 110
                  }
                ]
              }
            ]
          },
          "options": {
            "showHeader": true,
            "footer": {
              "show": false
            },
            "cellHeight": "sm"
          },
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "falcon-postgres"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT cve_id, severity, exprt_rating, cvss_base_score AS cvss, is_cisa_kev AS kev, hostname, platform_name AS platform, product_name, last_seen FROM falcon.v_open_vulns WHERE severity IN (${severity:singlequote}) AND COALESCE(platform_name,'UNKNOWN') IN (${platform:singlequote}) AND ('${host}' = '' OR hostname ILIKE '%${host}%') AND ('${kev}' = 'all' OR is_cisa_kev = ${kev}) ORDER BY (severity='CRITICAL') DESC, cvss_base_score DESC NULLS LAST, last_seen DESC LIMIT 5000",
              "refId": "A"
            }
          ]
        }
      ],
      "schemaVersion": 39,
      "tags": [
        "falcon",
        "crowdstrike"
      ],
      "templating": {
        "list": [
          {
            "type": "query",
            "name": "severity",
            "label": "Severity",
            "datasource": {
              "type": "postgres",
              "uid": "falcon-postgres"
            },
            "query": "SELECT DISTINCT severity FROM falcon.v_open_vulns WHERE severity IS NOT NULL ORDER BY 1",
            "refresh": 2,
            "multi": true,
            "includeAll": true,
            "allValue": null,
            "definition": "SELECT DISTINCT severity FROM falcon.v_open_vulns WHERE severity IS NOT NULL ORDER BY 1",
            "options": [],
            "current": {
              "selected": true,
              "text": [
                "All"
              ],
              "value": [
                "$__all"
              ]
            },
            "sort": 1
          },
          {
            "type": "query",
            "name": "platform",
            "label": "Platform",
            "datasource": {
              "type": "postgres",
              "uid": "falcon-postgres"
            },
            "query": "SELECT DISTINCT COALESCE(platform_name,'UNKNOWN') FROM falcon.v_open_vulns ORDER BY 1",
            "refresh": 2,
            "multi": true,
            "includeAll": true,
            "allValue": null,
            "definition": "SELECT DISTINCT COALESCE(platform_name,'UNKNOWN') FROM falcon.v_open_vulns ORDER BY 1",
            "options": [],
            "current": {
              "selected": true,
              "text": [
                "All"
              ],
              "value": [
                "$__all"
              ]
            },
            "sort": 1
          },
          {
            "type": "custom",
            "name": "kev",
            "label": "CISA KEV",
            "query": "All : all,KEV only : true,Non-KEV : false",
            "multi": false,
            "includeAll": false,
            "current": {
              "text": "All",
              "value": "all",
              "selected": true
            },
            "options": [
              {
                "text": "All",
                "value": "all",
                "selected": true
              },
              {
                "text": "KEV only",
                "value": "true",
                "selected": false
              },
              {
                "text": "Non-KEV",
                "value": "false",
                "selected": false
              }
            ]
          },
          {
            "type": "textbox",
            "name": "host",
            "label": "Hostname contains",
            "query": "",
            "current": {
              "text": "",
              "value": ""
            },
            "options": [
              {
                "text": "",
                "value": "",
                "selected": true
              }
            ]
          }
        ]
      },
      "time": {
        "from": "now-90d",
        "to": "now"
      },
      "timepicker": {},
      "timezone": "",
      "title": "Falcon \u2014 Vulnerabilities",
      "uid": "falcon-vulns",
      "version": 1,
      "weekStart": ""
    }