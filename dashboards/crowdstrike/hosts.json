apiVersion: grafana.integreatly.org/v1beta1
kind: GrafanaDashboard
metadata:
  name: falcon-hosts
  namespace: y-tree-crowdstrike
spec:
  allowCrossNamespaceImport: true
  instanceSelector:
    matchLabels:
      dashboards: grafana
  resyncPeriod: 10m0s
  json: |
    {
      "annotations": {
        "list": [
          {
            "builtIn": 1,
            "datasource": {
              "type": "grafana",
              "uid": "-- Grafana --"
            },
            "enable": true,
            "hide": true,
            "name": "Annotations & Alerts",
            "type": "dashboard"
          }
        ]
      },
      "editable": true,
      "fiscalYearStartMonth": 0,
      "graphTooltip": 0,
      "links": [],
      "liveNow": false,
      "panels": [
        {
          "type": "stat",
          "title": "Total hosts",
          "datasource": {
            "type": "postgres",
            "uid": "falcon-postgres"
          },
          "gridPos": {
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 4
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "color": {
                "mode": "fixed"
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "value",
            "graphMode": "none",
            "textMode": "auto",
            "justifyMode": "auto"
          },
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "falcon-postgres"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT count(*) AS v FROM falcon.v_host_coverage WHERE ('${host}' = '' OR hostname ILIKE '%${host}%') AND platform_name IN (${platform:singlequote})",
              "refId": "A"
            }
          ]
        },
        {
          "type": "stat",
          "title": "Stale sensors (>7d)",
          "datasource": {
            "type": "postgres",
            "uid": "falcon-postgres"
          },
          "gridPos": {
            "x": 6,
            "y": 0,
            "w": 6,
            "h": 4
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "color": {
                "mode": "fixed"
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "value",
            "graphMode": "none",
            "textMode": "auto",
            "justifyMode": "auto"
          },
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "falcon-postgres"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT count(*) FILTER (WHERE stale_sensor) AS v FROM falcon.v_host_coverage WHERE ('${host}' = '' OR hostname ILIKE '%${host}%') AND platform_name IN (${platform:singlequote})",
              "refId": "A"
            }
          ]
        },
        {
          "type": "stat",
          "title": "Reduced functionality (RFM)",
          "datasource": {
            "type": "postgres",
            "uid": "falcon-postgres"
          },
          "gridPos": {
            "x": 12,
            "y": 0,
            "w": 6,
            "h": 4
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "color": {
                "mode": "fixed"
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "value",
            "graphMode": "none",
            "textMode": "auto",
            "justifyMode": "auto"
          },
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "falcon-postgres"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT count(*) FILTER (WHERE reduced_functionality_mode = 'yes') AS v FROM falcon.v_host_coverage WHERE ('${host}' = '' OR hostname ILIKE '%${host}%') AND platform_name IN (${platform:singlequote})",
              "refId": "A"
            }
          ]
        },
        {
          "type": "stat",
          "title": "Servers",
          "datasource": {
            "type": "postgres",
            "uid": "falcon-postgres"
          },
          "gridPos": {
            "x": 18,
            "y": 0,
            "w": 6,
            "h": 4
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "color": {
                "mode": "fixed"
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "value",
            "graphMode": "none",
            "textMode": "auto",
            "justifyMode": "auto"
          },
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "falcon-postgres"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT count(*) FILTER (WHERE product_type_desc = 'Server') AS v FROM falcon.v_host_coverage WHERE ('${host}' = '' OR hostname ILIKE '%${host}%') AND platform_name IN (${platform:singlequote})",
              "refId": "A"
            }
          ]
        },
        {
          "type": "piechart",
          "title": "Hosts by platform",
          "datasource": {
            "type": "postgres",
            "uid": "falcon-postgres"
          },
          "gridPos": {
            "x": 0,
            "y": 4,
            "w": 8,
            "h": 9
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "hideFrom": {}
              }
            },
            "overrides": []
          },
          "options": {
            "pieType": "donut",
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "values": [
                "value"
              ]
            },
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "values": true
            },
            "tooltip": {
              "mode": "single"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "falcon-postgres"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT platform_name AS metric, count(*) AS value FROM falcon.v_host_coverage WHERE ('${host}' = '' OR hostname ILIKE '%${host}%') AND platform_name IN (${platform:singlequote}) GROUP BY platform_name ORDER BY 2 DESC",
              "refId": "A"
            }
          ]
        },
        {
          "type": "table",
          "title": "Hosts",
          "datasource": {
            "type": "postgres",
            "uid": "falcon-postgres"
          },
          "gridPos": {
            "x": 8,
            "y": 4,
            "w": 16,
            "h": 9
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "filterable": true,
                "align": "auto"
              }
            },
            "overrides": []
          },
          "options": {
            "showHeader": true,
            "footer": {
              "show": false
            },
            "cellHeight": "sm"
          },
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "falcon-postgres"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT hostname, platform_name AS platform, os_version, product_type_desc AS type, agent_version, reduced_functionality_mode AS rfm, cs_last_seen AS last_seen, open_total, open_critical FROM falcon.v_host_coverage WHERE ('${host}' = '' OR hostname ILIKE '%${host}%') AND platform_name IN (${platform:singlequote}) ORDER BY open_critical DESC, open_total DESC",
              "refId": "A"
            }
          ]
        }
      ],
      "schemaVersion": 39,
      "tags": [
        "falcon",
        "crowdstrike"
      ],
      "templating": {
        "list": [
          {
            "type": "query",
            "name": "platform",
            "label": "Platform",
            "datasource": {
              "type": "postgres",
              "uid": "falcon-postgres"
            },
            "query": "SELECT DISTINCT platform_name FROM falcon.hosts WHERE platform_name IS NOT NULL ORDER BY 1",
            "refresh": 2,
            "multi": true,
            "includeAll": true,
            "allValue": null,
            "definition": "SELECT DISTINCT platform_name FROM falcon.hosts WHERE platform_name IS NOT NULL ORDER BY 1",
            "options": [],
            "current": {
              "selected": true,
              "text": [
                "All"
              ],
              "value": [
                "$__all"
              ]
            },
            "sort": 1
          },
          {
            "type": "textbox",
            "name": "host",
            "label": "Hostname contains",
            "query": "",
            "current": {
              "text": "",
              "value": ""
            },
            "options": [
              {
                "text": "",
                "value": "",
                "selected": true
              }
            ]
          }
        ]
      },
      "time": {
        "from": "now-90d",
        "to": "now"
      },
      "timepicker": {},
      "timezone": "",
      "title": "Falcon \u2014 Hosts",
      "uid": "falcon-hosts",
      "version": 1,
      "weekStart": ""
    }