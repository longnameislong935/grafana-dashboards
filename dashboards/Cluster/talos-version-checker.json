{
  "title": "Talos \u2014 Image Versions (version-checker)",
  "uid": "talos-version-checker",
  "tags": ["talos"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": "victoria-metrics",
        "query": {
          "query": "label_values(version_checker_is_latest_version, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(version_checker_is_latest_version, namespace)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": ["talos"],
      "title": "Talos boards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 400,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Outdated images",
      "datasource": "victoria-metrics",
      "id": 401,
      "description": "Unique image:version pairs with a newer version available",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "count(count by (image, current_version) (version_checker_is_latest_version{namespace=~\"$namespace\"} == 0)) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Outdated containers",
      "datasource": "victoria-metrics",
      "id": 402,
      "description": "Running containers on an outdated image",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "count(version_checker_is_latest_version{namespace=~\"$namespace\"} == 0) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Namespaces affected",
      "datasource": "victoria-metrics",
      "id": 403,
      "description": "Namespaces running at least one outdated image",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "count(count by (namespace) (version_checker_is_latest_version{namespace=~\"$namespace\"} == 0)) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Up to date images",
      "datasource": "victoria-metrics",
      "id": 404,
      "description": "Unique image:version pairs on the latest version",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "count(count by (image, current_version) (version_checker_is_latest_version{namespace=~\"$namespace\"} == 1)) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "% up to date",
      "datasource": "victoria-metrics",
      "id": 405,
      "description": "Share of unique images on the latest version",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "green", "value": 90 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "100 * (count(count by (image, current_version) (version_checker_is_latest_version{namespace=~\"$namespace\"} == 1)) or vector(0)) / count(count by (image, current_version) (version_checker_is_latest_version{namespace=~\"$namespace\"}))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Images tracked",
      "datasource": "victoria-metrics",
      "id": 406,
      "description": "",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [],
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "count(count by (image, current_version) (version_checker_is_latest_version{namespace=~\"$namespace\"})) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Trend",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 407,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Image drift over time (unique images)",
      "datasource": "victoria-metrics",
      "id": 408,
      "description": "",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Outdated" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "red" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Up to date" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "green" }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "count(count by (image, current_version) (version_checker_is_latest_version{namespace=~\"$namespace\"} == 0)) or vector(0)",
          "legendFormat": "Outdated",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": "victoria-metrics",
          "expr": "count(count by (image, current_version) (version_checker_is_latest_version{namespace=~\"$namespace\"} == 1)) or vector(0)",
          "legendFormat": "Up to date",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Top namespaces - outdated containers",
      "datasource": "victoria-metrics",
      "id": 409,
      "description": "",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "continuous-YlRd" },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "topk(10, count by (namespace) (version_checker_is_latest_version{namespace=~\"$namespace\"} == 0))",
          "legendFormat": "{{namespace}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Outdated",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 410,
      "panels": []
    },
    {
      "type": "table",
      "title": "Outdated images",
      "datasource": "victoria-metrics",
      "id": 411,
      "description": "One row per image:version - most widely used first.",
      "gridPos": { "h": 10, "w": 10, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": { "align": "auto", "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Current" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "orange" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Latest" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "green" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Containers" },
            "properties": [{ "id": "custom.width", "value": 100 }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "Containers", "desc": true }]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "image": "Image",
              "current_version": "Current",
              "latest_version": "Latest",
              "Value": "Containers"
            },
            "indexByName": {
              "image": 0,
              "current_version": 1,
              "latest_version": 2,
              "Value": 3
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "count by (image, current_version, latest_version) (version_checker_is_latest_version{namespace=~\"$namespace\"} == 0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "type": "table",
      "title": "Outdated containers by workload",
      "datasource": "victoria-metrics",
      "id": 412,
      "description": "Every container running an outdated image.",
      "gridPos": { "h": 10, "w": 14, "x": 10, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "align": "auto", "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Current" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "orange" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Latest" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "green" }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "Namespace", "desc": false }]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Value": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "pod": "Pod",
              "container": "Container",
              "image": "Image",
              "current_version": "Current",
              "latest_version": "Latest"
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "container": 2,
              "image": 3,
              "current_version": 4,
              "latest_version": 5
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "max by (namespace, pod, container, image, current_version, latest_version) (version_checker_is_latest_version{namespace=~\"$namespace\"} == 0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "type": "row",
      "title": "All images",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 413,
      "panels": []
    },
    {
      "type": "table",
      "title": "All tracked images",
      "datasource": "victoria-metrics",
      "id": 414,
      "description": "Every image version-checker knows about, with status.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "align": "auto", "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.width", "value": 110 },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "Outdated", "color": "red", "index": 0 },
                      "1": {
                        "text": "Up to date",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "Status", "desc": false }]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "image": "Image",
              "current_version": "Current",
              "latest_version": "Latest",
              "Value": "Status"
            },
            "indexByName": {
              "namespace": 0,
              "image": 1,
              "current_version": 2,
              "latest_version": 3,
              "Value": 4
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "min by (namespace, image, current_version, latest_version) (version_checker_is_latest_version{namespace=~\"$namespace\"})",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ]
    }
  ]
}
