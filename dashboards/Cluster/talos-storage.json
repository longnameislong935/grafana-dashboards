    {
      "type": "table",
      "title": "Requested storage by namespace",
      "datasource": "victoria-metrics",
      "id": 120,
      "description": "Live PVC usage isn't exposed (kubelet volume stats empty); this is requested size.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "service": true
            },
            "renameByName": {
              "Value": "value"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "sum by (namespace)(kube_persistentvolumeclaim_resource_requests_storage_bytes)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ]
    },
