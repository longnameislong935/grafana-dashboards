    {
      "id": 11,
      "type": "table",
      "title": "Critical / High CVEs \u2014 by affected workloads",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Filter with the 'Fix available' variable. Click a CVE to open it on osv.dev.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (vuln_id, severity, vuln_score, resource, installed_version, fixed_version, vuln_title) (trivy_vulnerability_id{namespace=~\"$namespace\", severity=~\"Critical|High\", fixed_version=~\"$fixable\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "vuln_id": "CVE",
              "severity": "Severity",
              "vuln_score": "Score",
              "resource": "Package",
              "installed_version": "Installed",
