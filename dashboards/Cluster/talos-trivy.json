{
  "title": "Talos \u2014 Vulnerabilities (Trivy)",
  "uid": "talos-trivy",
  "tags": [
    "talos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": "victoria-metrics",
        "query": {
          "query": "label_values(trivy_image_vulnerabilities, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(trivy_image_vulnerabilities, namespace)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "fixable",
        "type": "custom",
        "label": "Fix available",
        "query": "All : .*,Fixable only : .+",
        "current": {
          "text": "All",
          "value": ".*"
        },
        "options": [
          {
            "text": "All",
            "value": ".*",
            "selected": true
          },
          {
            "text": "Fixable only",
            "value": ".+",
            "selected": false
          }
        ]
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "talos"
      ],
      "title": "Talos boards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 300,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Critical",
      "datasource": "victoria-metrics",
      "id": 301,
