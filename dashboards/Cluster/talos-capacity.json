    {
      "type": "gauge",
      "title": "CPU requests vs allocatable",
      "datasource": "victoria-metrics",
      "id": 190,
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "100 * sum(kube_pod_container_resource_requests{resource=\"cpu\"}) / clamp_min(sum(kube_node_status_allocatable{resource=\"cpu\"}),1)",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
