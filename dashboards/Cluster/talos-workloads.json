{
  "title": "Talos \u2014 Workloads",
  "uid": "talos-workloads",
  "tags": [
    "talos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
