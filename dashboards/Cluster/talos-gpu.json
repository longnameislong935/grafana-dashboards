{
  "title": "Talos \u2014 GPU (DCGM)",
  "uid": "talos-gpu",
  "tags": [
    "talos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "label": "Node",
        "datasource": "victoria-metrics",
        "query": {
          "query": "label_values(node_memory_MemTotal_bytes, instance)",
          "refId": "node"
        },
        "definition": "label_values(node_memory_MemTotal_bytes, instance)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "talos"
      ],
      "title": "Talos boards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Utilisation & memory",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 91,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "GPU utilisation %",
      "datasource": "victoria-metrics",
      "id": 92,
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "DCGM_FI_DEV_GPU_UTIL{Hostname=~\"$node\"}",
          "legendFormat": "{{Hostname}} gpu{{gpu}} {{modelName}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU memory used %",
      "datasource": "victoria-metrics",
      "id": 93,
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "100 * DCGM_FI_DEV_FB_USED{Hostname=~\"$node\"} / clamp_min(DCGM_FI_DEV_FB_USED{Hostname=~\"$node\"} + DCGM_FI_DEV_FB_FREE{Hostname=~\"$node\"},1)",
          "legendFormat": "{{Hostname}} gpu{{gpu}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
