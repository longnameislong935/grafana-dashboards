      },
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "100 * sum by (pod)(rate(container_cpu_cfs_throttled_periods_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",container!=\"POD\"}[5m])) / clamp_min(sum by (pod)(rate(container_cpu_cfs_periods_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",container!=\"POD\"}[5m])),1)",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "range": true,
          "instant": false
