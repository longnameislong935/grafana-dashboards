    {
      "type": "table",
      "title": "Last successful backup age",
      "datasource": "victoria-metrics",
      "id": 134,
      "description": "Seconds since last available backup.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "service": true
            },
            "renameByName": {
              "Value": "value"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": "victoria-metrics",
          "expr": "(time() - cnpg_collector_last_available_backup_timestamp{namespace=~\"$namespace\"}) > 0",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ]
    },
