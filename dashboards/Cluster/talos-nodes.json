      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "node_load1{instance=~\"$node\"} / count by (instance)(node_cpu_seconds_total{mode=\"idle\",instance=~\"$node\"})",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU by mode (cluster)",
      "datasource": {
